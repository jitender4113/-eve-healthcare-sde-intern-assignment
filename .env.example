PORT=3000
DATABASE_URL=postgres://eve:eve@localhost:5432/eve
# Used by `npm test` (the test suite wipes this database)
TEST_DATABASE_URL=postgres://eve:eve@localhost:5432/eve_test
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN_SECONDS=3600
WEBHOOK_SECRET=change-me-webhook-secret
# Probability that a simulated payment succeeds when no outcome is forced
PAYMENT_SUCCESS_RATE=0.8
# Requests per minute per IP on /auth endpoints
AUTH_RATE_LIMIT_PER_MINUTE=10
LOG_LEVEL=info
